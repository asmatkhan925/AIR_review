# Normalize text files to LF in the repository
* text=auto eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.docx binary
*.pptx binary
*.xlsx binary

# Keep common source/text formats normalized
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.bib text eol=lf
*.tex text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
